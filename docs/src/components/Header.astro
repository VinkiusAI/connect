---
import config from 'virtual:starlight/user-config';
import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';

const shouldRenderSearch =
  config.pagefind ||
  config.components.Search !== '@astrojs/starlight/components/Search.astro';
---

<div class="vk-header">
  <div class="vk-header__brand">
    <SiteTitle />
  </div>

  <div class="vk-header__actions print:hidden">
    <div class="vk-header__search">
      {shouldRenderSearch && <Search />}
    </div>

    <div class="vk-header__preferences">
      <LanguageSelect />
      <ThemeSelect />
    </div>

    <a
      class="vk-header__github" 
      href="https://github.com/VinkiusAI/connect"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="View Vinkius Connect on GitHub (opens in a new tab)"
    >
      <svg class="vk-header__github-mark" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 0C5.37 0 0 5.5 0 12.28c0 5.43 3.44 10.03 8.2 11.66.6.12.82-.27.82-.59 0-.29-.01-1.06-.02-2.08-3.34.74-4.04-1.65-4.04-1.65-.55-1.42-1.33-1.8-1.33-1.8-1.09-.76.08-.74.08-.74 1.2.09 1.84 1.27 1.84 1.27 1.07 1.87 2.81 1.33 3.5 1.02.11-.8.42-1.33.76-1.64-2.67-.31-5.47-1.37-5.47-6.07 0-1.34.47-2.44 1.24-3.3-.13-.31-.54-1.56.11-3.25 0 0 1.01-.33 3.3 1.26a11.3 11.3 0 0 1 6 0c2.29-1.59 3.3-1.26 3.3-1.26.65 1.69.24 2.94.12 3.25.77.86 1.23 1.96 1.23 3.3 0 4.71-2.81 5.75-5.49 6.06.43.38.82 1.13.82 2.28 0 1.64-.02 2.96-.02 3.36 0 .32.22.71.83.59A12.2 12.2 0 0 0 24 12.28C24 5.5 18.63 0 12 0Z"></path>
      </svg>
      <span class="vk-header__github-label">View on GitHub</span>
      <svg class="vk-header__github-arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M5 11 11 5M6 5h5v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </a>
  </div>
</div>

<style>
  @layer starlight.core {
    .vk-header {
      width: 100%;
      height: 100%;
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
      gap: clamp(1rem, 3vw, 2.5rem);
    }

    .vk-header__brand,
    .vk-header__actions,
    .vk-header__preferences,
    .vk-header__github {
      display: flex;
      align-items: center;
    }

    .vk-header__brand {
      min-width: 0;
    }

    .vk-header__actions {
      height: var(--vk-header-control-height);
      min-width: 0;
      justify-self: end;
      justify-content: flex-end;
      gap: 0;
    }

    .vk-header__search {
      width: clamp(14rem, 18vw, 17rem);
      min-width: 0;
      height: 100%;
      display: flex;
      justify-content: flex-end;
    }

    .vk-header__preferences {
      height: 100%;
      flex: 0 0 auto;
      gap: 0;
      border-block: 1px solid rgba(255, 255, 255, 0.13);
      border-radius: 0;
      background: transparent;
      box-shadow: none;
    }

    .vk-header__github {
      height: 100%;
      flex: 0 0 auto;
      justify-content: center;
      gap: 0.55rem;
      margin-inline-start: -1px;
      border: 1px solid #f7f7f4;
      border-radius: 0;
      padding-inline: 1rem 0.85rem;
      color: #050505 !important;
      background: #f7f7f4;
      font-family: var(--sl-font-mono);
      font-size: 0.61rem;
      font-weight: 650;
      letter-spacing: 0.045em;
      line-height: 1;
      text-decoration: none;
      text-transform: uppercase;
      box-shadow: none;
      transition: color 160ms ease, border-color 160ms ease, background-color 160ms ease;
    }

    .vk-header__github:hover {
      border-color: #dfff4f;
      color: #050505 !important;
      background: #dfff4f;
      box-shadow: none;
    }

    .vk-header__github-mark {
      width: 1rem;
      height: 1rem;
      flex: 0 0 auto;
    }

    .vk-header__github-arrow {
      width: 0.72rem;
      height: 0.72rem;
      flex: 0 0 auto;
      color: rgba(5, 5, 5, 0.48);
      transition: color 160ms ease, transform 160ms var(--vk-ease-out);
    }

    .vk-header__github:hover .vk-header__github-arrow {
      color: #050505;
      transform: translate(1px, -1px);
    }

    @media (max-width: 68rem) {
      .vk-header__search {
        width: clamp(12.75rem, 21vw, 14.5rem);
      }

      .vk-header__github-arrow {
        display: none;
      }
    }

    @media (max-width: 60rem) {
      .vk-header__search {
        width: var(--vk-header-control-height);
      }

      .vk-header__github-label,
      .vk-header__github-arrow {
        display: none;
      }

      .vk-header__github {
        width: var(--vk-header-control-height);
        padding: 0;
      }
    }

    @media (max-width: 49.999rem) {
      .vk-header {
        gap: 0.75rem;
      }

      .vk-header__brand {
        min-width: 0;
        overflow: clip;
      }

      .vk-header__actions {
        flex: 0 0 auto;
      }

      .vk-header__preferences {
        display: none;
      }
    }

    @media (max-width: 25rem) {
      .vk-header__github {
        display: none;
      }
    }
  }
</style>
